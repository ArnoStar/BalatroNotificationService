# Copy to .env (never commit it). Every variable is optional; the defaults
# suit `make run` with `make rabbitmq` (RabbitMQ from the game's compose file,
# BalatroFrontEnd/docker-compose.yml).

RABBITMQ_URL=amqp://balatro:balatro@localhost:5672/
# messages handled at the same time
RABBITMQ_PREFETCH=10
# a message that failed for now waits RETRY_DELAY_SECONDS, at most MAX_ATTEMPTS
# times, then goes to the notification.email.failed queue. (Changing the delay
# needs the notification.email.retry queue deleted first.)
RETRY_DELAY_SECONDS=30
MAX_ATTEMPTS=5

# console (the emails in the log) or smtp. For an inbox in development:
# docker compose --profile mail up -d mailpit (in BalatroFrontEnd), then
# EMAIL_BACKEND=smtp SMTP_HOST=localhost SMTP_PORT=1025 SMTP_SECURITY=none,
# and read them at http://localhost:8025
EMAIL_BACKEND=console
EMAIL_FROM=Balatro <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465) or none
SMTP_SECURITY=starttls

# in the emails: the site's name and its address (the portal)
SITE_NAME=Balatro
SITE_URL=http://localhost:5174
